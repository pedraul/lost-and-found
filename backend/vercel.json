{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    { "path": "/api/cron/payment-confirmations", "schedule": "0 3 * * *" },
    { "path": "/api/cron/payment-reminders", "schedule": "0 7 * * *" }
  ]
}
