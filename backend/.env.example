# Server
NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lost_found
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage (AWS S3 or compatible)
STORAGE_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_S3_ENDPOINT=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Gmail email delivery (password resets, payment receipts, and reminders)
# Use a Google App Password, not your normal Gmail password.
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM=

# Paypack production API
PAYMENT_MODE=paypack
PAYPACK_API_BASE_URL=https://payments.paypack.rw/api
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_WEBHOOK_MODE=production
# Register https://<your-backend-domain>/api/payments/paypack/webhook in the
# Paypack application dashboard with the same webhook mode and signing secret.

# Annual registration subscription
PAYMENT_ANNUAL_AMOUNT_RWF=1000
PAYMENT_ANNUAL_DURATION_DAYS=365

# File Upload
MAX_FILE_SIZE=10mb
UPLOAD_DIR=uploads

# Payment transaction encryption (AES-256-GCM). Required unless PAYMENT_MODE=mock.
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and backed up: payments cannot be decrypted without it.
PAYMENT_ENCRYPTION_KEY=
# When rotating, move the old key here (comma-separated) and run: npm run encrypt:payments
PAYMENT_ENCRYPTION_PREVIOUS_KEYS=

# --- Production on Vercel (see README.md → Deploying to Vercel) ---
# Hosted PostgreSQL connection string. Added automatically when you connect a
# Neon database to the Vercel project; overrides the DB_* settings above.
DATABASE_URL=
# Vercel Blob store token for uploaded photos. Added automatically when you
# connect a Blob store; without it uploads go to the local uploads/ folder.
BLOB_READ_WRITE_TOKEN=
# Secret Vercel Cron sends to /api/cron/* (any long random string).
CRON_SECRET=
# Keeps the raw request body intact for Paypack webhook signature checks.
NODEJS_HELPERS=0
